<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"> 
    
    <!-- สิทธิ์การใช้งานอินเทอร์เน็ตและเครือข่าย -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- สิทธิ์การจัดการไฟล์ -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    
    <!-- สิทธิ์การติดตั้งและแจ้งเตือน -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- สิทธิ์สำหรับการรัน Foreground Service เบื้องหลัง -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="MiniStudio"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:requestLegacyExternalStorage="true"> 
        
        <!-- Activity หน้าแรก -->
        <activity
            android:name=".ProjectListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity 
            android:name=".AiSettingsActivity"
            android:exported="false" />

        <!-- Services สำหรับงานเบื้องหลัง -->
        <service 
            android:name=".GitHubPushService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service 
            android:name=".GitHubCloneService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service 
            android:name=".DownloadApkService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FileProvider สำหรับส่งไฟล์ APK ให้ระบบติดตั้ง -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
