        <item name="colorPrimary">#BB9AF7</item>
        <item name="colorPrimaryVariant">#7AA2F7</item>
        <item name="colorOnPrimary">#1A1B26</item>

        <!-- Secondary -->
        <item name="colorSecondary">#7DCFFF</item>
