<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1B26"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1A1B26"
            app:titleTextColor="#C0CAF5"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1F2335"
            android:padding="6dp">

            <TextView
                android:id="@+id/tvFilePath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/no_file_open"
                android:textColor="#565F89"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvSaveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/saved"
                android:textColor="#9ECE6A"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="#1F2335"
            android:scrollbars="none" />

        <!-- searchBar -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#24283B"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etFind"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="@string/search_hint"
                    android:textColor="#C0CAF5"
                    android:textColorHint="#565F89"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/tvSearchCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0"
                    android:textColor="#565F89"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <ImageButton
                    android:id="@+id/btnSearchPrev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/arrow_up_float"
                    android:contentDescription="ก่อนหน้า"
                    app:tint="#A9B1D6" />

                <ImageButton
                    android:id="@+id/btnSearchNext"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/arrow_down_float"
                    android:contentDescription="ถัดไป"
                    app:tint="#A9B1D6" />

                <ImageButton
                    android:id="@+id/btnCloseSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="ปิด"
                    app:tint="#A9B1D6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/etReplace"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="@string/replace_hint"
                    android:textColor="#C0CAF5"
                    android:textColorHint="#565F89"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/btnReplace"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/btn_replace"
                    android:textColor="#7AA2F7"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnReplaceAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/btn_replace_all"
                    android:textColor="#BB9AF7"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <CheckBox
                    android:id="@+id/cbCaseSensitive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/case_sensitive"
                    android:textColor="#A9B1D6"
                    android:textSize="12sp"
                    android:buttonTint="#7AA2F7" />
            </LinearLayout>
        </LinearLayout>

        <!-- Editor Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#1A1B26">

            <FrameLayout
                android:id="@+id/emptyStateView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible"
                android:background="#1A1B26">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/open_file_from_drawer"
                    android:textColor="#565F89"
                    android:textSize="15sp" />
            </FrameLayout>

            <io.github.rosemoe.sora.widget.CodeEditor
                android:id="@+id/codeEditor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/previewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1A1B26"
                android:visibility="gone" />
        </FrameLayout>

        <!-- consolePanel (ย้ายมาไว้ใต้ Editor ดันพื้นที่ขึ้นลงแยกชั้นชัดเจน) -->
        <LinearLayout
            android:id="@+id/consolePanel"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:orientation="vertical"
            android:background="#1A1B26"
            android:elevation="8dp"
            android:visibility="gone">

            <!-- แถบปุ่ม consoleToolbar -->
            <LinearLayout
                android:id="@+id/consoleToolbar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:background="#16161E">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/btnConsoleRun"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/btn_run"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_btn_console_run" />

                        <TextView
                            android:id="@+id/btnConsoleStop"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/btn_stop"
                            android:textColor="#C0CAF5"
                            android:textSize="13sp"
                            android:background="@drawable/bg_btn_console_secondary" />

                        <TextView
                            android:id="@+id/btnConsoleClear"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/btn_clear"
                            android:textColor="#C0CAF5"
                            android:textSize="13sp"
                            android:background="@drawable/bg_btn_console_secondary" />

                        <TextView
                            android:id="@+id/btnLogcat"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/btn_logcat"
                            android:textColor="#7AA2F7"
                            android:textSize="13sp"
                            android:background="@drawable/bg_btn_console_secondary" />

                        <TextView
                            android:id="@+id/btnCopyCrash"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/btn_copy_crash"
                            android:textColor="#E0AF68"
                            android:textSize="13sp"
                            android:visibility="gone"
                            android:background="@drawable/bg_btn_console_secondary" />
                    </LinearLayout>
                </HorizontalScrollView>

                <ImageButton
                    android:id="@+id/btnCloseConsole"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="ปิด"
                    android:padding="8dp"
                    app:tint="#F7768E" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#292E42" />

            <!-- พื้นที่ log -->
            <ScrollView
                android:id="@+id/consoleScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:background="#1A1B26">

                <TextView
                    android:id="@+id/tvConsole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="#A9B1D6"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    android:textIsSelectable="true"
                    android:lineSpacingExtra="2dp" />
            </ScrollView>
        </LinearLayout>

        <!-- แถบล่าง (Shortcuts) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1F2335">

            <LinearLayout
                android:id="@+id/shortcutRow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/shortcutBar"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/aiShortcutBar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mainShortcutRow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:background="#1A1B26">

                <ImageView
                    android:id="@+id/btnToggleShortcut"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_expand_more_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle shortcuts"
                    android:scaleType="centerInside" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:fillViewport="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/btnUndo"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_undo_24"
                            android:background="@drawable/bg_dialog_input"
                            android:layout_marginStart="4dp"
                            android:contentDescription="Undo"
                            android:scaleType="centerInside" />

                        <ImageView
                            android:id="@+id/btnRedo"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_redo_24"
                            android:background="@drawable/bg_dialog_input"
                            android:layout_marginStart="4dp"
                            android:contentDescription="Redo"
                            android:scaleType="centerInside" />

                        <ImageView
                            android:id="@+id/btnColorPicker"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_palette_24"
                            android:background="@drawable/bg_dialog_input"
                            android:layout_marginStart="4dp"
                            android:contentDescription="Color Picker"
                            android:scaleType="centerInside" />

                        <ImageView
                            android:id="@+id/btnPreview"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_preview_24"
                            android:background="@drawable/bg_dialog_input"
                            android:layout_marginStart="4dp"
                            android:contentDescription="Preview"
                            android:scaleType="centerInside" />

                        <ImageView
                            android:id="@+id/btnFileSearch"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_search_file_24"
                            android:background="@drawable/bg_dialog_input"
                            android:layout_marginStart="4dp"
                            android:contentDescription="ค้นหาไฟล์"
                            android:scaleType="centerInside" />

                        <ImageView
                            android:id="@+id/btnGitPush"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_git_push_24"
                            android:background="@drawable/bg_dialog_input"
                            android:layout_marginStart="4dp"
                            android:contentDescription="Push to GitHub"
                            android:scaleType="centerInside" />
                    </LinearLayout>
                </HorizontalScrollView>

                <ImageView
                    android:id="@+id/btnMainAi"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_ai_24"
                    android:background="@drawable/bg_dialog_input"
                    android:contentDescription="AI"
                    android:scaleType="centerInside" />
            </LinearLayout>
        </LinearLayout>

        <!-- Error panel -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvErrorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2A1F24"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Drawer โครงสร้างโปรเจกต์ -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1F2335"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:id="@+id/drawer_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp"
            android:clipToPadding="false">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/project_structure"
                android:textColor="#C0CAF5"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8dp" />

            <ListView
                android:id="@+id/treeView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:clipToPadding="false" />
        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
